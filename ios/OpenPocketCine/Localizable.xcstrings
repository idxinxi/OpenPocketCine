    "%@ refused (0x%@) — quit Mimo, power-cycle the camera, then tap once": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ refused (0x%@) — quit Mimo, power-cycle the camera, then tap once"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 被拒绝（0x%@）——请退出 Mimo，给相机断电重启，再点一次"
          }
        }
      }
    },
    "%@ timed out — camera didn't reply (AP still coming up?)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ timed out — camera didn't reply (AP still coming up?)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 超时了——相机没回话（它的 Wi-Fi 热点还没起来？）"

            "value": "BLE + Wi-Fi active"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BLE + Wi-Fi 已连接"
          }
        }
      }
    },
    "Before pairing, turn off DJI Frame Tap and force quit DJI Mimo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before pairing, turn off DJI Frame Tap and force quit DJI Mimo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对之前，请先关掉 DJI Frame Tap，并彻底退出 DJI Mimo。"
          }
        }
      }
    },
    "Bluetooth is not ready yet. Try again in a moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is not ready yet. Try again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙还没准备好，稍后再试一次。"
          }
        }
      }
    },
    "Bluetooth is off. Turn it on in Control Center or Settings, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is off. Turn it on in Control Center or Settings, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙已关闭。请在控制中心或设置里打开蓝牙，然后重试。"
          }
        }
      }
    },
    "Bluetooth reached a different camera than the one you tapped. Pocket and Nano are separate — pick the Nano or Pocket row in the list.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth reached a different camera than the one you tapped. Pocket and Nano are separate — pick the Nano or Pocket row in the list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙连到了另一台相机，不是你点的那台。Pocket 和 Nano 是分开的——请在列表里选 Nano 或 Pocket 那一行。"
          }
        }
      }
    },
    "Camera": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机"
          }
        }
      }
    },
    "Camera Wi-Fi could not be restored. Keep it powered on and close Multiview to retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Wi-Fi could not be restored. Keep it powered on and close Multiview to retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机 Wi-Fi 无法恢复。请保持相机开机，关闭多机位后重试。"
          }
        }
      }
    },
    "Camera control speaks DUML over Bluetooth and the camera's Wi-Fi. No DJI SDK is bundled or required.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera control speaks DUML over Bluetooth and the camera's Wi-Fi. No DJI SDK is bundled or required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机控制走蓝牙和相机 Wi-Fi 上的 DUML 协议，不内置也不需要 DJI SDK。"
          }
        }
      }
    },
    "Camera could not complete this step. Check the Wi-Fi details and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera could not complete this step. Check the Wi-Fi details and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机没能完成这一步。请检查 Wi-Fi 信息，再试一次。"
          }
        }
      }
    },
    "Camera did not enter playback.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera did not enter playback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机没有进入回放。"
          }
        }
      }
    },
    "Camera did not respond. Close other camera apps and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera did not respond. Close other camera apps and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机没有回应。请关掉其他相机应用，再试一次。"
          }
        }
      }
    },
    "Camera discovery returned an unavailable address. Tap Reconnect to search again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera discovery returned an unavailable address. Tap Reconnect to search again."

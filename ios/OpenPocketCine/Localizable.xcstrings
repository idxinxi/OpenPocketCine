          "stringUnit": {
            "state": "translated",
            "value": "相机发现返回了一个不可用的地址。点“重新连接”重新搜索。"
          }
        }
      }
    },
    "Camera is not nearby. Check that it is powered on.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera is not nearby. Check that it is powered on."

    },
    "%@ of %@ confirmed · check camera tiles": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@ confirmed · check camera tiles"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@ 台已确认 · 请检查各机位"

  "strings": {
    " · unverified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · unverified"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · 未验证"
          }
        }
      }
    },
    "%@ came back empty — camera AP not up yet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ came back empty — camera AP not up yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 返回为空——相机热点还没起来"
          }
        }
      }
    },
    "%@ cameras connected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cameras connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 台相机已连接"
          }
        }
      }
    },
    "%@ isn't D-Log or D-Log2.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't D-Log or D-Log2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是 D-Log 或 D-Log2。"
          }
        }
      }
    },
    "%@ joins this iPhone’s hotspot “%@”. Turn on Personal Hotspot and Allow Others to Join (Settings or Control Center), then tap Connect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joins this iPhone’s hotspot “%@”. Turn on Personal Hotspot and Allow Others to Join (Settings or Control Center), then tap Connect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将加入这台 iPhone 的热点“%@”。请打开个人热点并允许其他人加入（在设置或控制中心里），然后点连接。"
          }
        }
      }
    },
    "%@ live · %@ cameras": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ live · %@ cameras"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 台实时 · 共 %@ 台"
          }
        }
      }
    },
    "%@ live · %@ reconnecting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ live · %@ reconnecting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 台实时 · %@ 台重连中"
          }
